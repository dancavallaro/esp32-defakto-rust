# Copy to cfg.toml (gitignored). Read at build time by toml-cfg. Every value is
# optional: the setup wizard edits them on the device and saves them in NVS,
# which wins over this file. The wizard runs when settings are missing.
[demo-firmware]
wifi_ssid = ""
wifi_psk = ""
# From the IdP's OIDC discovery document.
login_device_url = ""
login_token_url = ""
login_client_id = ""
# Defakto's serverless API, which also serves token exchange at /oauth/token.
defakto_endpoint = "https://defakto.o.cavnet.cloud"
# The Trust Domain Server's issuer URL (the `iss` of any JWT-SVID it issues).
svid_audience = ""
# The check-in service's endpoint, which receives the OBO token as a
# bearer token. Leave it out to stop at the token exchange.
# checkin_url = ""
# Optional; these are the defaults.
# device_id = "defakto-demo"
# subject_token_type = "urn:ietf:params:oauth:token-type:id_token"
# requested_token_type = "urn:defakto:security:token-type:jwt-svid-obo"
# obo_audience = "defakto-demo"
# attestors = "efuse,tee"    # those enabled; "tee" alone for the XIAO, which has no eFuse key
# default_attestor = "efuse" # or "tee"; a long press on idle switches, and the choice survives reboots
# efuse_hmac_key = 5         # eFuse key block holding the secret for "efuse"
# Build-time only: with these, saving settings in the wizard takes a Defakto
# DevID JWT-SVID for the device ID, from a SPIFFE ID under devid_subjects. The
# device verifies it once it has joined the new network, before using them.
# devid_issuer = "https://fed.spirl.org/t-…/td-…"
# devid_subjects = "spiffe://example.org/users/"
