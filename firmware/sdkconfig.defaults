# Rust's std needs more than the 3 KB default main stack; TLS handshakes need more still.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# 4 MB covers the XIAO and still boots on the Waveshare's 8 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_LWIP_SNTP_MAX_SERVERS=4

# ESP-TEE runs attestation; its secure storage stays in development mode, so no eFuse keys.
CONFIG_SECURE_ENABLE_TEE=y
CONFIG_MBEDTLS_TEE_SEC_STG_ECDSA_SIGN=n
# Only satisfies the IDF build: the flashed table is partitions.csv (see flash.sh).
CONFIG_PARTITION_TABLE_SINGLE_APP_TEE=y
